generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Apartment {
  id              String @id @default(cuid())
  imagePath       String
  name            String
  city            String
  street          String
  rentalFee       Int
  apartmentSize   Int
  rooms           Int
  description     String
  floor           String
  elevator        String
  parkingSpace    String
  available       String
  fullDescription String

  kitchenType        String?
  bathroomWithToilet String?
  balcony            String?
  terrace            String?
  market             String?

  buildingType     String?
  buildingMaterial String?
  dateBuilding     String?

  addedDate       String?
  lastUpdate      String?
  idAdvertisement String?
  views           Int?    @default(0)

  opinions Opinion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opinion {
  id             String @id @default(cuid())
  customerId     String
  gender         String
  firstName      String
  lastName       String
  opinionDate    String
  opinionContent String
  rating         Int

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  createdAt DateTime @default(now())
}

model Attraction {
  id   String @id @default(cuid())
  text String
  img  String
}

model GalleryImage {
  id          String @id @default(cuid())
  imgPath     String
  description String
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  gender       String?
  firstName    String?
  lastName     String?
  phone        String?
  role         Role     @default(USER)

  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  HEAD_ADMIN
}

model Message {
  id      String  @id @default(cuid())
  name    String
  email   String
  number  String
  subject String
  message String
  check   Boolean @default(false)

  createdAt DateTime @default(now())
}

model ContactRequest {
  id          String  @id @default(cuid())
  message     String
  name        String
  email       String
  phoneNumber String
  news        Boolean @default(false)
  loan        Boolean @default(false)

  createdAt DateTime @default(now())
}

model PhoneCallRequest {
  id     String @id @default(cuid())
  number String
  time   String

  createdAt DateTime @default(now())
}